# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file!

# DVLA API Configuration
DVLA_API_KEY=your-dvla-api-key-here

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# DVLA Vehicle Enquiry Service API
REACT_APP_DVLA_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles

# DVLA Proxy URL (for local development)
REACT_APP_DVLA_PROXY_URL=/api/vehicle-enquiry.js

# Note: Twilio credentials and other sensitive keys should be set in Supabase Edge Functions environment
# Do not add sensitive production keys to this React app .env file