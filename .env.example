# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file!

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Server / local API proxy variable (Vercel or local `npm start`)
DVLA_API_KEY=your-dvla-api-key

# Note: Twilio credentials, ADMIN_SESSION_SECRET, and SUPABASE_SERVICE_ROLE_KEY
# are set as secrets in Supabase Edge Functions, never in the React app.