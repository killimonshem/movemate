# Auto detect text files and perform LF normalization
* text=auto

# Force LF for these files (cross-platform compatibility)
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Denote all files that are binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# Exclude files from archive downloads
.env export-ignore
.env.* export-ignore
*.log export-ignore